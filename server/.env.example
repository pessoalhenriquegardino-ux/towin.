# ---- Banco de dados ----
# Em produção (Vercel) use o Turso. Deixe em branco localmente: o app usa o arquivo server/data/towin.sqlite
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# ---- IA (Coach) ----
ANTHROPIC_API_KEY=

# ---- Notificações push (npm run generate-vapid) ----
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:seu-email@exemplo.com

# ---- Segurança ----
# Senha de acesso ao app. Em branco = sem login (ok só no seu computador).
APP_PASSWORD=
# Texto aleatório longo usado para assinar a sessão (opcional; se vazio usa a senha).
SESSION_SECRET=
# Segredo que o agendador (GitHub Actions) usa para chamar /api/cron/notificar.
CRON_SECRET=

# ---- Outros ----
APP_TIMEZONE=America/Sao_Paulo
PORT=8787
